{
  "name": "carehold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && python3 -m unittest discover -s tests -p test_*.py",
    "db:local": "wrangler d1 migrations apply carehold-local --local",
    "db:remote": "wrangler d1 migrations apply carehold-staging --remote",
    "auth:check": "npx @better-auth/cli check schema",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.0",
    "@mmmike/web-push": "^1.5.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "better-auth": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.560.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wrangler": "^4.50.0"
  }
}
