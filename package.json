{
  "name": "carehold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && python3 -m unittest discover -s tests -p test_*.py",
    "db:local": "wrangler d1 migrations apply carehold-local --local",
    "db:remote": "npm run preflight:staging && wrangler d1 migrations apply carehold-staging --remote --env staging",
    "auth:check": "npx @better-auth/cli check schema",
    "deploy:staging": "npm run preflight:staging && npm run build && wrangler deploy --env staging",
    "release:staging": "bash scripts/release-staging.sh",
    "preflight:production": "node scripts/check-production-config.mjs",
    "configure:production": "node scripts/configure-production.mjs",
    "release:production": "bash scripts/release-production.sh",
    "push:setup": "node scripts/configure-local-push.mjs",
    "db:backup:local": "bash scripts/backup-local.sh",
    "preflight:staging": "node scripts/check-staging-config.mjs",
    "configure:staging": "node scripts/configure-staging.mjs",
    "verify:pre-e2e": "npm run typecheck && npm test && npm run build",
    "build:homebase": "VITE_HOMEBASE_ENABLED=true npm run build",
    "db:homebase:local": "wrangler d1 migrations apply DB --local --config wrangler.homebase.jsonc --persist-to .wrangler/homebase-care",
    "dev:homebase": "wrangler dev --local --config wrangler.homebase.jsonc --persist-to .wrangler/homebase-care --ip 127.0.0.1 --port 8793"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.0",
    "@mmmike/web-push": "^1.5.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "better-auth": "^1.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.560.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wrangler": "^4.50.0"
  }
}
