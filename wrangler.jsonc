{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "carehold-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{"binding":"DB", "database_name":"carehold-local", "database_id":"00000000-0000-0000-0000-000000000000", "migrations_dir":"migrations"}],
  "assets": {"directory":"./dist", "binding":"ASSETS", "run_worker_first":["/api/*"]},
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {"APP_ORIGIN":"http://localhost:5173"},
  "env": {
    "staging": {
      "name":"carehold-staging",
      "d1_databases":[{"binding":"DB","database_name":"carehold-staging","database_id":"REPLACE_STAGING_D1_ID","migrations_dir":"migrations"}],
      "vars":{"APP_ORIGIN":"https://REPLACE-STAGING-HOST"}
    },
    "production": {
      "name":"carehold-production",
      "d1_databases":[{"binding":"DB","database_name":"carehold-production","database_id":"REPLACE_PRODUCTION_D1_ID","migrations_dir":"migrations"}],
      "vars":{"APP_ORIGIN":"https://REPLACE-PRODUCTION-HOST"}
    }
  }
}
