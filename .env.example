# Local ONLY. Copy to .dev.vars, replace with cryptographically random private secrets.
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTE_SECRET
PILOT_ACCESS_CODE=REPLACE_WITH_LONG_RANDOM_PILOT_CODE
# For actual Web Push delivery; do not put private key in source or client.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.invalid
